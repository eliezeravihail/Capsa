{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Capsa platform",
  "description": "A target the product ships to (SPEC 0.4.0 section 4.14).",
  "type": "object",
  "required": [
    "title",
    "status",
    "created"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "supported",
        "best_effort",
        "deprecated",
        "unsupported"
      ]
    },
    "created": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}"
    },
    "links": {
      "type": "array",
      "items": {
        "$ref": "../../core/schema/link.schema.json"
      }
    }
  }
}
