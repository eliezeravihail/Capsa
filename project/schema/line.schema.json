{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Capsa release line",
  "description": "One maintained version stream (SPEC 0.4.0 section 4.13).",
  "type": "object",
  "required": [
    "title",
    "status",
    "created"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "active",
        "maintained",
        "eol"
      ]
    },
    "created": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}"
    },
    "eol_date": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^\\d{4}-\\d{2}-\\d{2}"
    },
    "links": {
      "type": "array",
      "items": {
        "$ref": "../../core/schema/link.schema.json"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "eol"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "eol_date"
        ],
        "properties": {
          "eol_date": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  ]
}
