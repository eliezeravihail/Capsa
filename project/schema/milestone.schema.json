{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Capsa milestone",
  "description": "A dated point several plans aim at (SPEC 0.4.0 section 4.12).",
  "type": "object",
  "required": [
    "title",
    "status",
    "target_date"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "planned",
        "active",
        "reached",
        "missed",
        "cancelled"
      ]
    },
    "target_date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}"
    },
    "reached": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^\\d{4}-\\d{2}-\\d{2}"
    },
    "links": {
      "type": "array",
      "items": {
        "$ref": "../../core/schema/link.schema.json"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "reached"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "reached"
        ],
        "properties": {
          "reached": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  ]
}
