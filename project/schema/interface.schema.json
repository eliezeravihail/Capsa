{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Capsa interface",
  "description": "A contract the project exposes and others depend on (SPEC 0.4.0 section 4.11).",
  "type": "object",
  "required": [
    "title",
    "status",
    "created"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "proposed",
        "stable",
        "deprecated",
        "removed"
      ]
    },
    "created": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}"
    },
    "since": {
      "type": [
        "string",
        "null"
      ]
    },
    "deprecated_in": {
      "type": [
        "string",
        "null"
      ]
    },
    "removed_in": {
      "type": [
        "string",
        "null"
      ]
    },
    "code_globs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "links": {
      "type": "array",
      "items": {
        "$ref": "../../core/schema/link.schema.json"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "deprecated"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "deprecated_in"
        ],
        "properties": {
          "deprecated_in": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "removed"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "removed_in"
        ],
        "properties": {
          "removed_in": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  ]
}
